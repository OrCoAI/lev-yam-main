# macOS
.DS_Store
**/.DS_Store

# Editors
.vscode/
.idea/

# Claude Code agent state — settings/local state stays untracked; skills ship
# with the repo. The gate depends on the verify skill for everyone, and the
# Bluebox skills are part of the platform's observability workflow (roadmap H8,
# docs/plans/bluebox-observability.md) — both must survive `git clone`.
# (.claude/* + negation, not a bare .claude/ — git can't re-include a path
# inside an already-excluded parent directory. The `**` form means a new skill
# is tracked automatically rather than needing its own negation line.)
# Skills are vendor-generated guidance; verified token-free before tracking.
.claude/*
!.claude/skills/
!.claude/skills/**

# Platform build (app-src/) — Node deps, build output, and local env
node_modules/
app-src/dist/
.env
.env.local
.env.*.local

# Bluebox OTel config template — generated per-repo by `bluebox setup local-repos`.
# Token-free by design, but it carries an OTLP endpoint and is machine-generated,
# not source. The repo is public; keep it local.
.env.otel.bluebox-template

# Assembled site (scripts/build-site.sh) + Cloudflare local state — build output
_site/
.wrangler/

# Local secrets — NEVER commit. Kept at repo root (outside app-src/ and the
# deploy allowlist in .github/workflows/deploy.yml), so it is not published.
.secrets/

# Private strategy docs — the repo is PUBLIC. Internal marketing/content
# strategy is read locally by Claude Code and never pushed.
docs/internal/

# Supabase CLI local artifacts (cache, branch state) — not source
supabase/.temp/
supabase/.branches/

# Raw source media (committed-optimized versions live in img/hero/)
img/hero/*.MOV
img/hero/*.mov
img/hero/hero.webm

# Logs
*.log
app-src/tsconfig.tsbuildinfo
