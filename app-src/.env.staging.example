# Point local dev / the /verify gate at the CLOUD STAGING project instead of the
# local Docker stack. Copy to .env.local and fill in the staging project's values.
#
# These are the anon/PUBLISHABLE values — safe to expose; RLS + Auth are the guard.
# NEVER put the service-role/secret key here (it lives only in staging Edge Functions
# + a GitHub Actions secret — see docs/plans/platform-staging-environment.md, PR 2).
#
# The same two values are set in the Cloudflare Pages build env for staging.levyam.com.
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-STAGING-ANON-PUBLISHABLE-KEY
