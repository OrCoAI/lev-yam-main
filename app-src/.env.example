# Copy to .env.local for local dev. These are the PUBLISHABLE (anon) values — safe to expose;
# Row-Level Security + Auth are the guard. NEVER put the service-role/secret key here.
#
# DEFAULT: the LOCAL Supabase stack (Docker). Start it first, from the repo root:
#   supabase start          # boots Postgres/Auth/PostgREST at 127.0.0.1:54321
#   supabase db reset        # applies migrations + seed.sql (synthetic users/data)
# then `cd app-src && npm run dev` (localhost:5173/app). Log in with a seeded user —
# owner@levyam.local / levyamdev (see supabase/seed.sql).
#
# The values below are the CLI's standard local defaults. If `supabase status` prints
# a different API URL or anon key, use those instead. Local dev never touches prod.
#
# To point at the cloud STAGING project instead, copy app-src/.env.staging.example.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
