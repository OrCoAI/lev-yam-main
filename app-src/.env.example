# Copy to .env.local for local dev. These are the PUBLISHABLE (anon) values — safe to expose;
# Row-Level Security + Auth are the guard. NEVER put the service-role/secret key here.
# In CI, set the same two values as GitHub repository "Secrets and variables".
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY
